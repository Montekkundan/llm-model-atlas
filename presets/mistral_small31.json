{
  "schema_version": 4,
  "family": "mistral_small31_text_tiny",
  "source_url": "https://huggingface.co/mistralai/Mistral-Small-3.1-24B-Instruct-2503/blob/main/config.json",
  "source_revision": "Mistral Small 3.1 text_config; Mistral inference transformer_layers.py and rope.py, accessed 2026-09-27",
  "fidelity": "tiny_text_path_not_checkpoint_compatible",
