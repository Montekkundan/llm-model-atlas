{
  "schema_version": 2,
  "family": "gemma3_text_tiny",
  "source_url": "https://arxiv.org/abs/2503.19786",
  "source_revision": "Gemma 3 Technical Report, Section 2; text-only 5:1 local/global teaching path",
  "fidelity": "tiny_text_path_not_checkpoint_compatible",
  "vocab_size": 64,
  "width": 32,
  "layers": 6,
  "query_heads": 4,
  "kv_heads": 2,
  "ff_hidden": 64,
  "max_context": 32,
  "attention_schedule": ["local", "local", "local", "local", "local", "global"],
  "local_window": 4,
  "rope_base_global": 1000000.0,
  "rope_base_local": 10000.0,
  "block_style": "pre_and_post_norm",
  "qk_norm": true,
  "qk_norm_axis": "head",
  "gate_activation": "gelu"
}
