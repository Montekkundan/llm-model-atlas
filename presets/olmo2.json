{
  "schema_version": 2,
  "family": "olmo2_text_tiny",
  "source_url": "https://arxiv.org/abs/2501.00656",
  "source_revision": "2 OLMo 2 Furious, Section 2.1 and Section 3.3.2; MHA-sized teaching path",
  "fidelity": "tiny_text_path_not_checkpoint_compatible",
  "vocab_size": 64,
  "width": 32,
  "layers": 2,
  "query_heads": 4,
  "kv_heads": 4,
  "ff_hidden": 64,
  "max_context": 32,
  "attention_schedule": ["global", "global"],
  "local_window": null,
  "rope_base_global": 500000.0,
  "rope_base_local": 500000.0,
  "block_style": "reordered_output_norm",
  "qk_norm": true,
  "qk_norm_axis": "projection",
  "gate_activation": "silu"
}
