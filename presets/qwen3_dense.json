{
  "schema_version": 4,
  "family": "qwen3_dense_text_tiny",
  "source_url": "https://huggingface.co/Qwen/Qwen3-0.6B/blob/main/config.json",
  "source_revision": "Qwen3-0.6B official config; Qwen3 modular_qwen3.py, accessed 2026-09-27",
  "fidelity": "tiny_text_path_not_checkpoint_compatible",
  "vocab_size": 64,
  "width": 32,
  "layers": 2,
  "query_heads": 4,
  "kv_heads": 2,
  "head_dim": 12,
  "ff_hidden": 64,
  "max_context": 32,
  "attention_schedule": [
    "global",
    "global"
  ],
  "local_window": null,
  "rope_base_global": 1000000.0,
  "rope_base_local": 1000000.0,
  "block_style": "pre_norm",
  "qk_norm": true,
  "qk_norm_axis": "head",
  "gate_activation": "silu",
  "rope_layout": "half",
  "norm_eps": 1e-06,
  "tie_embeddings": true,
  "mla_q_rank": null,
  "mla_kv_rank": null,
  "mla_rope_dim": null,
  "moe_experts": null,
  "moe_top_k": null,
  "moe_shared_experts": null
}
