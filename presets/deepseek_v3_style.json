{
  "schema_version": 4,
  "family": "deepseek_v3_style_text_tiny",
  "source_url": "https://arxiv.org/abs/2412.19437",
  "source_revision": "DeepSeek-V3 technical report section 2.1 and official inference/model.py, accessed 2026-09-27",
  "fidelity": "tiny_text_path_not_checkpoint_compatible",
  "vocab_size": 64,
  "width": 32,
  "layers": 4,
  "query_heads": 4,
  "kv_heads": 4,
  "head_dim": 8,
  "ff_hidden": 64,
  "max_context": 32,
  "attention_schedule": [
    "global",
    "global",
    "global",
    "global"
  ],
  "local_window": null,
  "rope_base_global": 10000.0,
  "rope_base_local": 10000.0,
  "block_style": "pre_norm",
  "qk_norm": false,
  "qk_norm_axis": "none",
  "gate_activation": "silu",
  "rope_layout": "adjacent",
  "norm_eps": 1e-06,
  "tie_embeddings": false,
  "mla_q_rank": 16,
  "mla_kv_rank": 12,
  "mla_rope_dim": 4,
  "moe_experts": 4,
  "moe_top_k": 2,
  "moe_shared_experts": 1
}
